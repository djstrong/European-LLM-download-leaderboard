{
  "version": 2,
  "description": "Version-specific European LLM leaderboard rows. Each row sums downloads from official Hugging Face repos only (published under official_org), including format variants (GGUF, MLX, FP8, GPTQ, AWQ, etc.) when that org publishes them.",
  "match_target": "huggingface_model_id",
  "regex_flavor": "python",
  "official_only": true,
  "regex_scope": "All patterns must match the full model id and start with ^{official_org}/. Third-party quantizations (mradermacher, QuantFactory, mlx-community, unsloth, …) are excluded.",
  "downloads_metric": "last_30_days",
  "downloads_api_note": "GET /api/models/{id}?expand[]=downloads&expand[]=downloadsAllTime: downloads = rolling last 30 days; downloadsAllTime = lifetime total. Parameter count via expand[]=safetensors (or expand[]=gguf for GGUF-only repos).",
  "deduplication": {
    "strategy": "each_repo_id_counts_once",
    "assignment": "first_matching_row_in_object_key_order",
    "comment": "List narrower version rows before broader ones (e.g. bielik-11b-v2.6 before any accidental broad pattern)."
  },
